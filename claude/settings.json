  "enabledPlugins": {
    "anki-workflows@yutoigarashi-skills": true
  },
  "extraKnownMarketplaces": {
    "yutoigarashi-skills": {
      "source": {
        "source": "github",
        "repo": "yutoigarashi-stack/agent-skills"
      },
      "autoUpdate": true
    }
  },
  "language": "japanese",
  "defaultMode": "acceptEdits",
  "effortLevel": "high",
  "tui": "default"
}
