    "allow": [
      "mcp__chrome-devtools",
      "mcp__slack__slack_post_message",
      "mcp__slack__slack_get_users",
      "mcp__slack__slack_list_channels",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready * --undo*)",
      "Bash(git worktree remove:*)",
      "Bash(git rebase:*)",
      "Bash(gh stack view:*)",
      "Bash(gh stack init:*)",
      "Bash(gh stack add:*)",
      "Bash(gh stack checkout:*)",
      "Bash(gh stack top:*)",
      "Bash(gh stack bottom:*)",
      "Bash(gh stack up:*)",
