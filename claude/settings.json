{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000",
    "CLAUDE_CODE_NO_FLICKER": "0",
    "ENABLE_TOOL_SEARCH": "true",
    "MCP_TIMEOUT": "120000"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
