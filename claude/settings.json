    "ask": [
      "Bash(curl:*)",
      "Bash(rm:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git push:*)",
      "Bash(gh stack push:*)",
      "Bash(gh stack sync:*)",
      "Bash(gh stack submit:*)",
      "Bash(gh stack link:*)",
      "Bash(git worktree remove * -f*)",
      "Bash(git worktree remove * --force*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
