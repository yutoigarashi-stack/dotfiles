      "Read(**/.env)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/credentials.json)",
      "Read(**/secrets.json)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Read(**/service-account*.json)",
      "Read(**/token.json)",
      "Read(**/token.pickle)",
      "Read(**/*.tfvars)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/.htpasswd)",
      "Edit(.env*)",
      "Edit(**/secrets/**)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm remove:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(mongod:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh stack merge:*)"
